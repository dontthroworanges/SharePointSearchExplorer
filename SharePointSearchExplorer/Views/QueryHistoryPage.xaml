<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SharePointSearchExplorer.Views.QueryHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SharePointSearchExplorer.Helpers"
    xmlns:views="using:SharePointSearchExplorer.Views">

    <Page.Resources>
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,20,0,6" />
        </Style>
        <Style x:Key="CardStackStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <!-- Compact settings-card surface for each saved query row. -->
        <Style x:Key="HistoryRowStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,6,8,6" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
    </Page.Resources>

    <!-- Same centred, width-capped column as the Settings page (see SettingsPage.CenterContent). -->
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        SizeChanged="ContentScroller_SizeChanged">
        <StackPanel x:Name="ContentPanel" Padding="36,20,36,40" HorizontalAlignment="Left" Style="{StaticResource CardStackStyle}">
            <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Query History" />

            <!-- Result of the last import or export. -->
            <InfoBar x:Name="StatusBar" IsOpen="False" />

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Recent queries" />
            <views:SettingsCard x:Name="HistoryCard" Header="Query suggestions" Icon="History">
                <views:SettingsCard.Action>
                    <Button x:Name="ClearHistoryButton" Click="ClearHistory_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.Delete}" />
                            <TextBlock Text="Clear history" />
                        </StackPanel>
                    </Button>
                </views:SettingsCard.Action>
            </views:SettingsCard>
            <views:SettingsCard
                Description="Save queries to an XML file to back them up or share them, or add queries from a file. Use the export button on a query to save just that one."
                Header="Import and export"
                Icon="ArrowExportLtr">
                <views:SettingsCard.Action>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Import_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.ArrowImport}" />
                                <TextBlock Text="Import…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportAllButton" Click="ExportAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.ArrowExportLtr}" />
                                <TextBlock Text="Export all…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </views:SettingsCard.Action>
            </views:SettingsCard>

            <TextBlock x:Name="SavedQueriesHeader" Style="{StaticResource GroupHeaderStyle}" Text="Saved queries" />
            <!-- One row per query, built in code (see UpdateHistory). -->
            <StackPanel x:Name="HistoryList" Style="{StaticResource CardStackStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
