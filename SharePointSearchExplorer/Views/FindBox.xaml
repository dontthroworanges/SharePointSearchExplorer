<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SharePointSearchExplorer.Views.FindBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SharePointSearchExplorer.Helpers"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Ctrl+F puts the focus in the box, from anywhere on the page or window that hosts it. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Invoked="FocusAccelerator_Invoked" Modifiers="Control" />
    </UserControl.KeyboardAccelerators>

    <!-- Search box, "3 of 17", then previous / next match. Searches the CodeBlock set as Target. -->
    <Grid ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="QueryBox"
            VerticalAlignment="Center"
            AutomationProperties.Name="Find in text"
            IsSpellCheckEnabled="False"
            KeyDown="QueryBox_KeyDown"
            PlaceholderText="Find in text"
            TextChanged="QueryBox_TextChanged"
            ToolTipService.ToolTip="Find in text (Ctrl+F). Enter goes to the next match, Shift+Enter to the previous one." />
        <TextBlock
            x:Name="CountText"
            Grid.Column="1"
            Margin="4,0"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}" />
        <Button
            x:Name="PreviousButton"
            Grid.Column="2"
            AutomationProperties.Name="Previous match"
            Click="Previous_Click"
            IsEnabled="False"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="Previous match (Shift+Enter)">
            <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.ArrowUp}" />
        </Button>
        <Button
            x:Name="NextButton"
            Grid.Column="3"
            AutomationProperties.Name="Next match"
            Click="Next_Click"
            IsEnabled="False"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="Next match (Enter)">
            <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.ArrowDown}" />
        </Button>
    </Grid>
</UserControl>
