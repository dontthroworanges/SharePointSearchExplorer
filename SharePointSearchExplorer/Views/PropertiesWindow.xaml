<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SharePointSearchExplorer.Views.PropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tab="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:h="using:SharePointSearchExplorer.Helpers"
    xmlns:views="using:SharePointSearchExplorer.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- A detached copy of the property table: fixed to the item it was opened from. -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <views:PropertyGridResources />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: item title, with "Properties" as subtitle. -->
        <TitleBar x:Name="WindowTitleBar" Height="48" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <Image Width="20" Height="20" Margin="16,0,0,0" Source="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <TextBlock
            x:Name="PathText"
            Grid.Row="1"
            Margin="24,4,24,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsTextSelectionEnabled="True"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />

        <!-- Filter bar, same as on the Search Results page. -->
        <Grid x:Name="FilterBar" Grid.Row="2" Margin="24,8,24,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000*" MaxWidth="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FilterBox"
                VerticalAlignment="Center"
                AutomationProperties.Name="Filter properties"
                PlaceholderText="Filter properties"
                TextChanged="FilterBox_TextChanged" />
            <CommandBar Grid.Column="2" Background="Transparent" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                <!-- Show/hide empty: labelled with what a click does (see UpdateEmptyToggle). -->
                <AppBarButton x:Name="EmptyToggle" Click="EmptyToggle_Click">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="EmptyToggleIcon" FontFamily="{StaticResource FluentIconsFont}" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="CopyAll_Click" Icon="{h:FluentIcon Icon=Copy}" Label="Copy all" />
            </CommandBar>
        </Grid>

        <!-- The table's help text is the tooltip of its Value header. -->
        <Border Grid.Row="3" Margin="24,8,24,16" Style="{StaticResource TableCardStyle}">
            <tab:TableView
                x:Name="PropertyGrid"
                AutomationProperties.Name="Properties"
                ContextRequested="PropertyGrid_ContextRequested"
                SizeChanged="PropertyGrid_SizeChanged"
                Sorting="PropertyGrid_Sorting"
                Style="{StaticResource PropertyGridStyle}" />
        </Border>
    </Grid>
</Window>
